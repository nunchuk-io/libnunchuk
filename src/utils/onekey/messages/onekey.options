nunchuk.onekey.*.address_n type:FT_CALLBACK
nunchuk.onekey.*.coin_name max_size:16
nunchuk.onekey.Features.* max_size:128
nunchuk.onekey.Features.capabilities max_count:64
nunchuk.onekey.Failure.message max_size:256
nunchuk.onekey.PinMatrixAck.pin max_size:51
nunchuk.onekey.PassphraseAck.passphrase max_size:51
nunchuk.onekey.HDNode.chain_code max_size:32
nunchuk.onekey.HDNode.public_key max_size:33
nunchuk.onekey.PublicKey.xpub max_size:128
nunchuk.onekey.Multisig.pubkeys max_count:15
nunchuk.onekey.Address.address max_size:128
nunchuk.onekey.MessageSignature.address max_size:128
nunchuk.onekey.MessageSignature.signature max_size:65
nunchuk.onekey.TxRequestDetails.tx_hash max_size:32
nunchuk.onekey.TxRequestSerialized.signature max_size:80
nunchuk.onekey.Transaction.inputs max_count:1
nunchuk.onekey.Transaction.outputs max_count:1
nunchuk.onekey.Transaction.bin_outputs max_count:1
nunchuk.onekey.TxInput.prev_hash max_size:32
nunchuk.onekey.TxOutput.address max_size:128
